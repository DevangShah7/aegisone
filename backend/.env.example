# Sample environment for local development.
# Generate a fresh copy with `python scripts/gen-secrets.py` from the repo root.

# Runtime
ENVIRONMENT=dev
LOG_LEVEL=INFO
APP_PORT=8000

# Database (matches infra/docker-compose.yml)
DATABASE_URL=postgresql+psycopg://aegisone:aegisone_dev_only@localhost:5432/aegisone
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Secrets — REPLACE before running in any non-dev environment.
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=AEGISONE_DEV_ONLY_REPLACE_ME_!!!
JWT_REFRESH_SECRET_KEY=AEGISONE_DEV_ONLY_REPLACE_ME_2!!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated allowlist. Never "*" with credentials.
CORS_ORIGINS=http://localhost:3000

# Trusted reverse proxies (CIDR list). X-Forwarded-Proto honored only from these.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aegisone
MINIO_SECRET_KEY=aegisone_dev_only
MINIO_BUCKET=aegisone

# Rate limits
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_LOGIN_PER_EMAIL_PER_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=3

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet for backend comms. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground services for the always-visible pairing notification
         and each capability (per Android 14+ requirements). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Location for the "Locate device" capability (consent-gated). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Camera diagnostic -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Microphone diagnostic -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Personal data -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Lost device lock (optional; harmless if the user opts not to
         grant Device Admin). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required to query package metadata for application inventory. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:name=".AegisOneApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AegisOne"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="33">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AegisOne.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.AegisOneForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".diagnostics.LostDeviceService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".diagnostics.CameraDiagnosticService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <service
            android:name=".diagnostics.MicrophoneDiagnosticService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".diagnostics.ScreenshotService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".diagnostics.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".device.AegisNotificationListener"
            android:exported="true"
            android:label="AegisOne notification access"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".device.GeofenceReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aegisone.agent.GEOFENCE" />
            </intent-filter>
        </receiver>

        <!-- Hilt-aware WorkManager: disable the default initializer so the
             Hilt-driven Configuration.Provider takes over. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>